{
  "name": "db-dojo",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive practice platform for PostgreSQL (SQL, permissions, indexes, plpgsql) — offline-capable PWA.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },

  "workspaces": [
    "packages/core",
    "packages/infrastructure",
    "packages/exercise-kit",
    "packages/exercises/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @db-dojo/web",
    "build": "npm run build -w @db-dojo/web",
    "preview": "npm run preview -w @db-dojo/web",
    "server:dev": "npm run dev -w @db-dojo/server",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "typescript": "^7.0.2"
  }
}
